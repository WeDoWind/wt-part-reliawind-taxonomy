<http://purl.ontoforge.org/wedo/reilatax> a skos:ConceptScheme;
  dct:contributor <https://orcid.org/0000-0002-6570-6966>;
  dct:creator <https://orcid.org/0000-0002-6570-6966>;
  dct:description "A taxonomical organization of wind turbine compenents used within Reliawind project."@en;
  dct:isReferencedBy <https://doi.org/10.1016/j.rser.2014.10.087>;
  dct:title "Reliawind Taxonomy of Wind Turbine Components"@en;
  skos:hasTopConcept <http://purl.ontoforge.org/wedo/reilataxWindFarm>, <http://purl.ontoforge.org/wedo/reilataxWindTurbine>;
  skos:prefLabel "Reliawind Taxonomy of Wind Turbine Components"@en .

<http://purl.ontoforge.org/wedo/reilataxhierarchyLevel> a rdf:Property;
  rdfs:label "Reliawind Hierarchy Level"@en;
  skos:definition "Reliawind classification assigns each concept to one of the 5 hierarchy levels: System, Sub-System, Assembly, Sub-Assembly, and Component."@en;
  skos:prefLabel "Hierarchy Level"@en .

<http://purl.ontoforge.org/wedo/reilataxWindTurbine> a skos:Concept;
  <http://purl.ontoforge.org/wedo/reilataxhierarchyLevel> "System"@en;
  skos:definition "A rotating machinery in which the kinetic wind energy is transformed into another form of energy."@en;
  skos:exactMatch <http://purl.org/neat/WindTurbine>;
  skos:inScheme <http://purl.ontoforge.org/wedo/reilatax>;
  skos:narrower <http://purl.ontoforge.org/wedo/reilataxDriveTrainModule>, <http://purl.ontoforge.org/wedo/reilataxElectricalModule>,
    <http://purl.ontoforge.org/wedo/reilataxNacelleModule>, <http://purl.ontoforge.org/wedo/reilataxRotorModule>,
    <http://purl.ontoforge.org/wedo/reilataxSupportStructure>;
  skos:prefLabel "Wind Turbine"@en;
  skos:topConceptOf <http://purl.ontoforge.org/wedo/reilatax> .

<http://purl.ontoforge.org/wedo/reilataxWindFarm> a skos:Concept;
  <http://purl.ontoforge.org/wedo/reilataxhierarchyLevel> "System"@en;
